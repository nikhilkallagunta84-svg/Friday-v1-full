# Copy this file to .env and fill in local-only values.
# Never commit real secrets.

RESEND_API_KEY=
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8765
FRIDAY_ENABLE_VOICE=1
FRIDAY_SILENT_TTS=0
FRIDAY_OLLAMA_MODEL=qwen3:4b
FRIDAY_FAST_MODEL=qwen3:1.7b
FRIDAY_CODE_MODEL=qwen2.5-coder:7b
FRIDAY_VISION_MODEL=llama3.2-vision:11b
FRIDAY_WHISPER_MODEL=base.en

# Optional account routing helpers. Leave blank unless you want FRIDAY to prefer
# a specific signed-in Google account for Google workflows.
FRIDAY_GOOGLE_ACCOUNT=
FRIDAY_PERSONAL_GOOGLE_ACCOUNT=
FRIDAY_CLASSROOM_GOOGLE_ACCOUNT=
